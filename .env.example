# Copy to .env, protect it with mode 0600, and generate every secret independently.
# Active values are local development defaults. Sections below mark settings for
# Standalone self-hosting, the Hosted platform, and Development only. Commented
# entries are optional: omit them rather than leaving them blank.

# ---------------------------------------------------------------------------
# Core (all modes)
# ---------------------------------------------------------------------------
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3211
# Planned production host; apply these values only in the production environment.
# PUBLIC_ORIGIN=https://entitle.doublesharp.com
# PUBLIC_ORIGIN is shared by the application and HTTPS proxy.
# Explicit root mount for the local/standalone app. Hosted mode defaults to /app
# when this override is omitted; match the frontend build's mount.
APP_BASE_PATH=
PORT=3211
# Keep APP_SECRET backed up to decrypt outbox credentials.
APP_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
OPERATOR_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Local macOS defaults keep data and builds on the Scratch volume. On other
# systems, use repository-relative paths instead:
# DATA_DIR=./.data
# BUILD_DIR=./dist
DATA_DIR=/Volumes/Scratch/entitle/data/local
BUILD_DIR=/Volumes/Scratch/entitle/build/main
# DATABASE_URL=postgresql://user:password@localhost:5432/entitle
# DATABASE_URL=mysql://user:password@localhost:3306/entitle
# DATABASE_URL=sqlite:/srv/entitle/entitle.sqlite
# WORK_DIR=/srv/entitle/work
# WEB_DIR=/app/dist/web
# Runtime role: all (default: migrate, serve HTTP and run workers), api, worker
# or migrate. See docs/configuration.md before splitting roles.
# SERVER_ROLE=all
# Optional blue/green readiness identity for the deployment router: blue or green.
# DEPLOYMENT_SLOT=blue
# Privileged account actions: hardware or passkey. When omitted, the default is
# hardware, the high-assurance policy requiring two approved hardware security
# keys. passkey accepts any user-verified passkey not added through recovery.
PRIVILEGED_AUTH_POLICY=passkey
LOCAL_BILLING=true
# Set to the exact private reverse-proxy IP/subnet, never blanket true.
TRUST_PROXY=
# Optional internal URL for authenticated operator CLI behind the proxy.
OPERATOR_ORIGIN=http://127.0.0.1:3211

# ---------------------------------------------------------------------------
# Standalone self-host: one publisher, primary workspace, direct Stripe
# ---------------------------------------------------------------------------
# Set the owner email before signing in at /seller. No Connect/platform price needed.
DEPLOYMENT_MODE=standalone
STANDALONE_OWNER_EMAIL=
# Optional operator-verified direct merchant identity for standalone encrypted export.
# STANDALONE_STRIPE_ACCOUNT_ID=acct_REPLACE
#
# Docker Compose reads the ENTITLE_* values below for interpolation when started
# with --env-file .env; the application itself ignores them.
#   All-in-one: docker compose --env-file .env -f deploy/compose.standalone.yaml up -d --build
#   Split web runtime: deploy/compose.yaml, with an activated frontend release.
# Absolute persistent host directory. The app mounts only ENTITLE_DATA_DIR/app
# (create it owned by UID/GID 1000); Caddy keeps its TLS keys in the separate
# caddy-data/ and caddy-config/ directories.
# ENTITLE_DATA_DIR=/srv/entitle
# Application container memory limit.
# ENTITLE_MEMORY_LIMIT=768m
# Split web runtime only: the hostname from PUBLIC_ORIGIN and the release root.
# ENTITLE_PUBLIC_HOST=licenses.example.com
# ENTITLE_WEB_RELEASE_DIR=/srv/entitle/frontend
# Split web runtime app mount. Empty or / selects the default /app; standalone
# releases have no app/ directory and are served at the root.
# ENTITLE_APP_BASE_PATH=/app

# ---------------------------------------------------------------------------
# Hosted platform: multitenant SaaS with Stripe Connect
# ---------------------------------------------------------------------------
# Explicitly use DEPLOYMENT_MODE=hosted, configure Connect and PLATFORM_STRIPE_PRICE_ID,
# and review docs/deployment.md for license rights. Existing multitenant databases
# must explicitly keep DEPLOYMENT_MODE=hosted.
# DEPLOYMENT_MODE=hosted
# Hosted only: defaults to 1%, in addition to the SaaS subscription and Stripe fees.
# HOSTED_APPLICATION_FEE_PERCENT=1
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=
PLATFORM_STRIPE_PRICE_ID=
# Hosted monthly Pro. Must be distinct from the Starter platform price.
# Omit entirely until configured; a blank optional value is not a valid price ID.
# PLATFORM_PRO_STRIPE_PRICE_ID=price_REPLACE
MAX_TENANTS_PER_SELLER=3
TRIAL_DAYS=14
GRACE_DAYS=7
TRIAL_STORAGE_MIB=100
PAID_MAX_PRODUCTS=20
PAID_STORAGE_MIB=1024
PLATFORM_DAILY_EMAIL_LIMIT=1000
MAX_SELLER_SIGNUPS_PER_HOUR=500
# Billing worker evidence and finalization ceilings. See docs/deployment.md for
# resource_limit recovery before increasing these values and retrying a job.
# BILLING_WORKER_MAX_FACTS=10000
# BILLING_WORKER_MAX_MIB=16
# BILLING_WORKER_MAX_APPLY_RECORDS=3000
# BILLING_WORKER_MAX_APPLY_WORK=1000000
# BILLING_WORKER_APPLY_MS=5000

# ---------------------------------------------------------------------------
# Stripe (both modes)
# ---------------------------------------------------------------------------
# For a production complimentary pilot, LOCAL_BILLING=false and leave all primary
# Stripe/Connect/platform price values empty. Configure the full set for payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Merchant webhook secret in standalone; platform webhook secret in hosted mode.
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
# Separate complete test-mode credentials, never live keys, for publisher Stripe sandboxes.
# STRIPE_TEST_SECRET_KEY=sk_test_REPLACE
# STRIPE_TEST_PUBLISHABLE_KEY=pk_test_REPLACE
# STRIPE_TEST_WEBHOOK_SECRET=whsec_REPLACE

# ---------------------------------------------------------------------------
# Storage, email and cache (both modes)
# ---------------------------------------------------------------------------
# Private S3-compatible bucket. Load the generated integration.env for the local fixture.
S3_BUCKET=entitle-local
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# HTTP is development-only and rejected in production.
S3_ALLOW_HTTP=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=licenses@example.test
DAILY_EMAIL_LIMIT=1000
# Optional adaptive-cache backend. Blank uses bounded in-memory caching, with no Redis.
CACHE_REDIS_URL=
# Examples: redis://cache:6379/0 or rediss://user:password@cache.example:6380/0
# Keep this URL private. Redis is disposable cache state, never entitlement authority.
CACHE_MEMORY_MIB=8
# Use a distinct namespace for separate deployments sharing a Redis server.
CACHE_NAMESPACE=entitle
# Optional additional webhook restriction. Exact public DNS names, comma separated.
# OUTBOUND_WEBHOOK_HOSTS=hooks.example.com,automation.example.com

# ---------------------------------------------------------------------------
# Upload, transfer and export limits (both modes)
# ---------------------------------------------------------------------------
MAX_UPLOAD_MIB=25
TRANSFER_MEMORY_MIB=256
# Native packages use file spools; WordPress retains MAX_UPLOAD_MIB above.
MAX_NATIVE_UPLOAD_MIB=100
# Incoming publication needs two disk copies, separate from the verified-download cache.
NATIVE_SPOOL_MIB=4096
NATIVE_UPLOAD_TIMEOUT_MS=120000
ARTIFACT_CACHE_MIB=4096
ARTIFACT_CACHE_INFLIGHT_MIB=2048
ARTIFACT_CACHE_TTL_MS=300000
# Transfer inactivity window; total native budgets scale with object size.
ARTIFACT_TRANSFER_TIMEOUT_MS=120000
MIN_DISK_FREE_MIB=64
# Shared encrypted export admission: one active bundle per tenant.
# Count includes creations in progress; disk reservation is shared across all bundles.
EXPORT_MAX_EXPORTS=4
EXPORT_MAX_GIB=10

# ---------------------------------------------------------------------------
# Public campaigns and OIDC publishing (both modes)
# ---------------------------------------------------------------------------
# Optional public complimentary campaigns. Empty disables signup. No billing needed.
# Use immutable campaign terms, actual tenant/product slugs, an ISO UTC expiry,
# and exact HTTPS website origins. See docs/api.md#public-free-license-signup.
FREE_LICENSE_OFFERS=[]
# OIDC publishing defaults to GitHub Actions. This JSON array replaces the defaults.
# OIDC_PROVIDERS=[{"id":"github","issuer":"https://token.actions.githubusercontent.com","jwksUrl":"https://token.actions.githubusercontent.com/.well-known/jwks","algorithms":["RS256"]}]

# ---------------------------------------------------------------------------
# Development, frontend builds and automation clients
# ---------------------------------------------------------------------------
# Disabled by default. Exact host or dot-delimited suffix, e.g. staging.example.com
DEVELOPMENT_HOST_SUFFIXES=
# Scoped seller automation, never shipped in browser code or plugin ZIPs.
TENANT_SLUG=
TENANT_API_KEY=
# Trusted OIDC publishing from CI with the CLI or MCP server, instead of an API key.
# ENTITLE_OIDC_PUBLISHER_ID=00000000-0000-0000-0000-000000000000
# Outside GitHub Actions, supply exactly one identity token source:
# ENTITLE_OIDC_TOKEN=REPLACE_WITH_CI_ID_TOKEN
# ENTITLE_OIDC_TOKEN_FILE=/run/secrets/entitle-oidc-token
# Frontend build inputs for pnpm build:web, build:marketing and build:hosted-web.
# Canonical and social metadata origin; omit to use the built-in default.
# WEB_PUBLIC_ORIGIN=https://licenses.example.com
# App mount baked into the build; must match APP_BASE_PATH (hosted: /app).
# WEB_APP_BASE_PATH=/app
# Application URL linked from the marketing site (default /app/).
# WEB_APP_URL=https://app.example.com/
